<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.moviebrowser.ui.home.HomeFragment"
        android:label="Филми">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.moviebrowser.ui.detail.DetailFragment"
        android:label="Детайли">
        <argument
            android:name="movieId"
            app:argType="integer"/>
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.moviebrowser.ui.favorites.FavoritesFragment"
        android:label="Любими">
        <action
            android:id="@+id/action_favorites_to_detail"
            app:destination="@id/detailFragment"/>
    </fragment>

</navigation>